<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Share a Memory - MediMemories</title>

  <link href="Memories.css" rel="stylesheet" type="text/css"/>
</head>
<body>
    <div class='logo'>
  <nav>
      <a href="HomePage.html">Back</a>
  </nav>
    </div>
  <main>
    <h1>Adding a memory for the grandparents (Share a Memory)</h1>
    <p>Share a story, piece of wisdom, or beautiful memory of your grandparents to be preserved on the site.</p>

    <form id="memoryForm">
      <div>
        <label for="senderName">the name:</label>
        
        <input type="text" id="senderName" name="senderName" placeholder="Write your name" >
      </div>
      <div>
        <label for="senderEmail">e-mail:</label>
        
        <input type="email" id="senderEmail" name="senderEmail" placeholder="example@email.com" >
      </div>
      <div>
        <label for="memoryType">Memory Type:</label>
        
        <select id="memoryType" name="memoryType">
            
          <option value="">-- Choose The Type Of Memory --</option>
          
          <option value="story"> An Old Story</option>
          
          <option value="advice">A Piece Of Advice Or Wisdom</option>
          
          <option value="tradition">A Habit Or Occasion </option>
        </select>
      </div>
      <fieldset>
      <legend>Relationship to the grandfather or grandmother:</legend>
      
      <label class="radio-item">
          
      <input type="radio" name="relation" value="Grandson"> Grandson
      
      </label>
      
      <label class="radio-item">
          
      <input type="radio" name="relation" value="Granddaughter"> Granddaughter
      
      </label>
      
      <label class="radio-item">
          
     <input type="radio" name="relation" value="A Family Member"> A Family Member
      </label>
      
      </fieldset>
      <fieldset>
        <legend>Sharing options:</legend>
        <label class='Checkbox-item'>
          <input type="checkbox" id="publishConsent" name="publishConsent">
          I agree to display the memory in the Memory Tree
        </label>
      </fieldset>
      <div>
        <label for="memoryText">What's the memory?</label>
        <textarea id="memoryText" name="memoryText" rows="4" placeholder="Write the memory here..."></textarea>
      </div>
      <div>
        <button type="button" id="getLocationBtn">Determining the geographical location:</button>
        <input type="text" id="locationOutput" name="locationOutput" placeholder="The coordinates will appear here" readonly>
      </div>

      <br>
      <button type="submit" id="submitBtn">Send The Memory</button>
    </form>
    <div id="formMessage"></div>
  </main>

  <script>
    // 1. برمجة خاصية Geolocation
    const getLocationBtn = document.getElementById("getLocationBtn");
    const locationOutput = document.getElementById("locationOutput");
    const formMessage = document.getElementById("formMessage");

    getLocationBtn.addEventListener("click", function () {
      if (!navigator.geolocation) {
        locationOutput.value = "The browser does not support Geolocation services..";
        return;
      }

      locationOutput.value = "Location is being determined...";

      navigator.geolocation.getCurrentPosition(
        function (position) {
          const lat = position.coords.latitude.toFixed(5);
          const lng = position.coords.longitude.toFixed(5);
          locationOutput.value = `latitude: ${lat} ، Longitude: ${lng}`;
        },
        function (error) {
          locationOutput.value = "Location could not be accessed (make sure you have allowed access to Geolocate you).";
        }
      );
    });

    // 2. برمجة زر الإرسال والتحقق من البيانات
    const memoryForm = document.getElementById("memoryForm");

    memoryForm.addEventListener("submit", function (event) {
      event.preventDefault(); // منع إعادة تحميل الصفحة قبل التحقق

      const name = document.getElementById("senderName").value.trim();
      const email = document.getElementById("senderEmail").value.trim();
      const memoryType = document.getElementById("memoryType").value;
      const relation = document.querySelector('input[name="relation"]:checked');
      const memoryText = document.getElementById("memoryText").value.trim();

      if (name === "") {
        formMessage.textContent = "Please enter name.";
        return;
      }

      if (email === "" || !email.includes("@")) {
        formMessage.textContent = "Please enter a valid email address.";
        return;
      }

      if (memoryType === "") {
        formMessage.textContent = "Please select the type of Memory from the list..";
        return;
      }

      if (!relation) {
        formMessage.textContent = "Please select the relationship.";
        return;
      }

      if (memoryText === "") {
        formMessage.textContent = "Please write your commemorative message before sending.";
        return;
      }

      formMessage.textContent = `Verified successfully! Thank you.  ${name}، The Memory was prepared in the type (${memoryType}).`;
      memoryForm.reset();
    });
  </script>

</body>
</html>
